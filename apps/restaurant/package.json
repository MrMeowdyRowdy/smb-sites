{
  "name": "restaurant",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "npm --prefix ../.. run lint",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "pretest:e2e": "node -e \"require('fs').rmSync('reports/axe',{recursive:true,force:true})\"",
    "test:e2e": "playwright test",
    "lhci": "CHROME_PATH=${CHROME_PATH:-/usr/bin/google-chrome} npx -y @lhci/cli@0.14.0 autorun --config=lighthouserc.json",
    "postlhci": "node -e \"const fs=require('fs');for(const d of fs.readdirSync('.').filter(n=>n.startsWith('C:')))fs.rmSync(d,{recursive:true})\"",
    "report": "node scripts/quality-report.mjs",
    "ci": "npm run lint && npm run typecheck && npm run test:unit && npm run build && npm run test:e2e && npm run lhci && npm run report && npm run build"
  },
  "dependencies": {
    "@smb/i18n": "0.0.0",
    "@smb/ui": "0.0.0",
    "gsap": "3.15.0",
    "next": "16.3.8",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@smb/config": "0.0.0",
    "@types/qrcode": "1.5.6"
  }
}
