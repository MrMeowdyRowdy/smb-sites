# Copy to .env for docker compose, or export in your shell. Never commit real values.
ADMIN_PASSWORD=change-me-local
# Required, 16+ characters: key for the admin cookie signature. Admin login refuses to work without it.
SESSION_SECRET=local-session-secret-not-for-production
POSTGRES_PASSWORD=clinic
# Host port for the compose Postgres (used by the e2e tests).
DB_PORT=5433
# Only without compose: DATABASE_URL=postgres://clinic:clinic@127.0.0.1:5433/clinic
# Set to true behind TLS so the admin cookie gets the Secure flag.
COOKIE_SECURE=false
