# Public base URL of the deployed site (canonical, hreflang, sitemap, QR code).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# WhatsApp number with country code, digits only. Placeholder default lives in content/site.json.
NEXT_PUBLIC_WHATSAPP=593900000000
# Optional: URL of one analytics script. Unset means no third-party script at all.
NEXT_PUBLIC_ANALYTICS_SRC=
